# Backend settings and secrets (read by the app and by docker-compose).
# The quickest way to get safe values:
#   python tools/generate_secrets.py --write .env
# then edit the site-specific values below (CORS_ORIGINS, timezone, shifts).
#
# APP_ENV=production refuses to start with placeholder secrets, without
# FACE_DATA_KEY, or on SQLite (see app/config_check.py).
# Keep this file private (chmod 600) and back it up OFF the server.
APP_ENV=production

# ---------------------------------------------------------------- secrets
# Each must be unique and at least 32 random characters.
SECRET_KEY=
JWT_SECRET_KEY=
# Fernet key; encrypts face embeddings, photos and snapshots at rest.
# BACK IT UP SEPARATELY from the database backups - without it the
# biometric data in every backup is unrecoverable and everyone must
# re-enroll.
FACE_DATA_KEY=

# --------------------------------------------------------------- database
# docker-compose's db and backup services read POSTGRES_PASSWORD from this
# same file; it must match the password inside DATABASE_URL.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg2://attendance:CHANGE_ME@db:5432/attendance

# -------------------------------------------------------- web / proxy / TLS
# The public address itself (SITE_ADDRESS) and TLS mode are set in the
# repo-root .env read by docker-compose (see deploy/env.example), not here.
#
# Origins allowed to call the API and open the live Socket.IO feed. Behind
# Caddy everything is same-origin, but Socket.IO still checks the Origin
# header against this list, so it MUST contain the exact address people
# type, with scheme (and port if not 443), comma separated:
#   CORS_ORIGINS=https://attendance.example.com
#   CORS_ORIGINS=https://attendance.lan,https://192.168.1.50
CORS_ORIGINS=https://localhost

# Reverse proxies in front of the app. docker-compose sets 1 (Caddy) for
# you; use 0 only when clients connect to gunicorn directly.
TRUST_PROXY_HOPS=1
# Refresh-token cookie only over HTTPS. Defaults to true when
# APP_ENV=production; set false only for a plain-HTTP dev setup.
JWT_COOKIE_SECURE=true

# ----------------------------------------------------------------- sessions
# Access tokens (memory only) and refresh cookies.
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
# KIOSK device accounts stay signed in this long before an admin must sign
# the tablet in again.
KIOSK_REFRESH_DAYS=30

# ---------------------------------------------------- sign-in protection
RATE_LIMITS_ENABLED=true
# Failed sign-ins per account before it is locked for LOGIN_LOCKOUT_MINUTES.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# ------------------------------------------------------------- organisation
# IANA timezone that decides what "today", late and overtime mean.
ORG_TIMEZONE=Asia/Manila
SHIFT_START=08:00
SHIFT_END=17:00
LATE_GRACE_MINUTES=15
BREAK_START=12:00
BREAK_END=13:00
# Minimum seconds between two punches by the same person (stops double
# punches from repeated frames).
ATTENDANCE_COOLDOWN_SECONDS=60
# A re-scan within this many seconds only re-confirms the last punch.
ATTENDANCE_REVERIFY_WINDOW_SECONDS=120

# -------------------------------------------------------------- recognition
# auto (SFace if backend/models has the ONNX files, else dlib) | sface | dlib
FACE_ENGINE=auto
MIN_ENROLLMENT_SAMPLES=5
MAX_ENROLLMENT_SAMPLES=12
LIVENESS_REQUIRED=true
LIVENESS_EAR_BLINK_DELTA=0.06

# Passive anti-spoofing: auto | off | log | enforce
# (enforce needs the MiniFASNet models, see models/README.md)
SPOOF_MODE=auto
# SPOOF_THRESHOLD=0.55

# Match thresholds are calibrated PER ENGINE in app/vision/engines.py.
# Leave these unset unless you've measured new values with
# tools/evaluate_accuracy.py on photos from your own kiosk cameras.
# FACE_MATCH_THRESHOLD=
# FACE_AMBIGUITY_MARGIN=
# ENROLL_CONSISTENCY_THRESHOLD=
# ENROLL_DUPLICATE_THRESHOLD=

# Sharpness floor for enrollment samples only (the kiosk keeps a looser one).
# ENROLL_BLUR_THRESHOLD=45

# ---------------------------------------------------- retention / privacy
# Scan snapshots shown in the Review queue. Matched scans are kept for
# SNAPSHOT_RETENTION_DAYS, unmatched (unknown face / spoof) for
# SNAPSHOT_UNMATCHED_RETENTION_DAYS, then purged automatically.
# Align these with your published privacy / retention policy.
SNAPSHOTS_ENABLED=true
SNAPSHOT_RETENTION_DAYS=90
SNAPSHOT_UNMATCHED_RETENTION_DAYS=30
# Database backup retention (BACKUP_KEEP) is set in the repo-root .env.

# ------------------------------------------------------------------ logging
LOG_LEVEL=INFO
