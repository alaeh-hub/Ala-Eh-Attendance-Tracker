# Secrets / local config
.env
.env.*
frontend/.env
frontend/.env.*
!.env.example
!frontend/.env.example

# Runtime data (face embeddings, photos, DB, logs) - never commit
backups/
*.dump
*.dump.partial
backend/instance/
backend/logs/
*.db
*.sqlite3
*.log

# Python
__pycache__/
*.py[cod]
.venv/
.voice-venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# TLS material for TLS_MODE=files (deploy/certs/cert.pem, key.pem)
deploy/certs/*
!deploy/certs/.gitkeep
*.pem
*.key

# Node / frontend
node_modules/
frontend/dist/
frontend/coverage/
*.tsbuildinfo

# Root-level stray lockfile (real one lives in frontend/)
/package-lock.json

# Editors / OS
.vs/
.vscode/
.idea/
Thumbs.db
.DS_Store
