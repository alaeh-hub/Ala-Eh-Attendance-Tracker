# Secrets / local config
.env
.env.*
frontend/.env
frontend/.env.*
!.env.example
!frontend/.env.example

# Runtime data (face embeddings, photos, DB, logs) - never commit
backups/
*.dump
*.dump.partial
backend/instance/
backend/logs/
*.db
*.sqlite3
# SQLite's write-ahead log, journal and shared-memory files sit next to the database while it is open
*.db-*
*.sqlite3-*
*.log
npm-debug.log*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.voice-venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# TLS material for TLS_MODE=files (deploy/certs/cert.pem, key.pem)
deploy/certs/*
!deploy/certs/.gitkeep
*.pem
*.key

# Node / frontend
node_modules/
frontend/dist/
frontend/coverage/
frontend/.vite/
*.tsbuildinfo

# Root-level stray lockfile (real one lives in frontend/)
/package-lock.json

# Generated end-to-end test pack
/docs/E2E_TEST_PACK.pdf

# Design-tool run records and screenshots (.hallmark/): regenerated on every run, not source
.hallmark/

# Editors / OS / assistants
.vs/
.vscode/
.idea/
.claude/settings.local.json
*.swp
Thumbs.db
desktop.ini
.DS_Store
