# Docker Compose settings for the production stack.
# Copy to the REPO ROOT as ".env" (next to docker-compose.yml):
#     cp deploy/env.example .env
# Compose reads this file automatically for ${...} substitution. Application
# settings and secrets live in backend/.env, not here.

# The address kiosks and admins type into the browser. One of:
#   attendance.example.com  public DNS name pointing at this server (TLS_MODE=acme)
#   attendance.lan          LAN DNS name (TLS_MODE=internal or files)
#   192.168.1.50            the server's fixed LAN IP (TLS_MODE=internal or files)
#   localhost               a single-machine trial
# Several addresses may be listed comma-separated, e.g. "attendance.lan, 192.168.1.50".
SITE_ADDRESS=localhost

# acme     - automatic publicly trusted certificate (needs ports 80/443 reachable
#            from the internet and public DNS for SITE_ADDRESS); enables HSTS
# internal - Caddy's own CA; install its root certificate on every kiosk/admin device
# files    - your own certificate: put cert.pem (full chain) and key.pem in
#            deploy/certs/ (mounted read-only into the caddy container)
TLS_MODE=internal

# Database backups (service "backup").
# Where dumps are written on the host (files are root-owned, mode 600).
# Copy this folder OFF the machine regularly - a backup on the same disk
# dies with the disk.
BACKUP_DIR=./backups
# How many daily dumps to keep.
BACKUP_KEEP=14
# Seconds between dumps (86400 = daily).
BACKUP_INTERVAL_SECONDS=86400
